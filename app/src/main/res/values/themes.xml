<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Reader" parent="android:Theme.Material.Light.NoActionBar">
        <item name="windowActionModeOverlay">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowContentOverlay">@color/windowBackground</item>
        <item name="android:windowBackground">@color/windowBackground</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">
            @drawable/ic_launcher_splash_screen
        </item>
    </style>

    <!--
        Applied only to the MDC BottomNavigationView (android:theme in activity_main.xml).
        Theme.Reader is a platform theme, which Material Components can't inflate under,
        so this gives that one view a Material3 context. Colors are synced from the
        Compose theme at runtime (see BottomNavBridge).
    -->
    <style name="ThemeOverlay.Reader.BottomNav" parent="Theme.Material3.DayNight.NoActionBar" />
</resources>